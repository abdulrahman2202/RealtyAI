# Enter these only in provider settings. Never commit real tokens or credentials.
# Render backend secrets: preserve the current values from the existing .env.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Render CORS: use the exact Vercel production origin after its URL is assigned.
CORS_ORIGINS=https://replace-with-your-project.vercel.app
REALTYAI_VECTOR_DB_DIR=/var/lib/realtyai/chroma
REALTYAI_COLLECTION_NAME=realtyai_multisource_v1
REALTYAI_COLLECTION_ID=51cdb05c-3ee9-4b04-b85c-71cbf168ff0d
REALTYAI_SNAPSHOT_ENDPOINT=https://YOUR-PROJECT.vercel.app/api/internal/chroma-snapshot
# Secret: generate locally and place the same value only in Render and Vercel server settings.
REALTYAI_SNAPSHOT_CLIENT_TOKEN=
REALTYAI_SNAPSHOT_BLOB_URL=https://YOUR-STORE.private.blob.vercel-storage.com/EXACT-UPLOADED-ARCHIVE-NAME.tar.gz
REALTYAI_SNAPSHOT_SHA256=63ffdfe00886556eb5af27ab0a8a8ac74c54f061e3eb1a50717a9360e9bd4fa5
REALTYAI_SNAPSHOT_MANIFEST_SHA256=a0189b6db2432cfdd43edfccb821250302fb7457ba73b7686422e64104c77ffc

# Vercel server-only settings. Connect the private Blob store with OIDC enabled.
BLOB_STORE_ID=
REALTYAI_SNAPSHOT_BLOB_PATH=realtyai_multisource_v1-63ffdfe00886556eb5af27ab0a8a8ac74c54f061e3eb1a50717a9360e9bd4fa5.tar.gz

# Vercel frontend: this public value is embedded during the production build.
NEXT_PUBLIC_API_URL=https://replace-with-your-service.onrender.com
