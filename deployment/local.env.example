# Copy to deployment/local.env; supply the existing Groq values without changing them.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
REALTYAI_DB_HOST_PATH=./data/vector_db_multisource
NEXT_PUBLIC_API_URL=http://127.0.0.1:18000
CORS_ORIGINS=http://localhost:13000,http://127.0.0.1:13000
BACKEND_PORT=18000
FRONTEND_PORT=13000
BACKEND_MEMORY_LIMIT=1g
BACKEND_CPU_LIMIT=1.0
